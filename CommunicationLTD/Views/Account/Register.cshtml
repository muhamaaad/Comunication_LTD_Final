@{
    ViewData["Title"] = "הרשמה";
    
}

<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Comunication_LTD</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body { background-color: #f8f9fa; }
        .auth-card { max-width: 400px; width: 100%; }
    </style>
</head>
<body>
<div class="container min-vh-100 d-flex align-items-center justify-content-center">
    <div class="card auth-card shadow-sm p-4 bg-white rounded">
        <div class="card-body">
            <div class="text-center mb-4">
                <h2 class="fw-bold text-dark">יצירת חשבון</h2>
                <p class="text-muted small">הרשמה כדי להתחיל</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label for="fullName" class="form-label text-secondary small fw-semibold">שם מלא</label>
                    <input type="text" class="form-control" id="fullName" name="fullName" required placeholder="ישראל ישראלי">
                </div>

                <div class="mb-3">
                    <label for="email" class="form-label text-secondary small fw-semibold">כתובת אימייל</label>
                    <input type="email" class="form-control" id="email" name="email" required placeholder="name@example.com">
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label text-secondary small fw-semibold">סיסמה</label>
                    <input type="password" class="form-control" id="password" name="password" required minlength="10" placeholder="הזן סיסמה">
                </div>

                <div class="mb-3">
                    <label for="confirmPassword" class="form-label text-secondary small fw-semibold">אימות סיסמה</label>
                    <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required minlength="10" placeholder="אימות סיסמה">
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">הרשמה</button>
            </form>

            <div class="text-center mt-4">
                <p class="text-muted small mb-0">כבר יש לך חשבון? <a asp-action="Login" class="text-decoration-none fw-semibold">התחבר</a></p>
            </div>
        </div>
    </div>
</div>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
