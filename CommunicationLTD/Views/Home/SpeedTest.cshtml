@{
    ViewData["Title"] = "בדיקת מהירות";
}

<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Comunication_LTD</title>
    <style>
        :root {
            --color-primary: #0F2847;
            --color-accent: #00D9FF;
            --color-success: #10B981;
            --color-text-dark: #0F1419;
            --color-text-muted: #6B7280;
            --color-bg-light: #F7F9FC;
            --color-border: #E5E7EB;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: var(--color-bg-light);
            color: var(--color-text-dark);
            margin: 0;
            padding: 3rem 1.5rem;
            line-height: 1.6;
            text-align: center;
        }

        .box {
            background: white;
            border-radius: 12px;
            padding: 3rem 2rem;
            max-width: 650px;
            margin: auto;
            box-shadow: 0 10px 30px rgba(15, 40, 71, 0.08);
            border-top: 4px solid var(--color-accent);
        }

        h2 {
            color: var(--color-primary);
            margin-top: 0;
            margin-bottom: 0.5rem;
            font-size: 2rem;
        }

        p.subtitle {
            color: var(--color-text-muted);
            margin-bottom: 2.5rem;
        }

        /* Metrics Grid for Ping, Download, Upload */
        .metrics {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 1rem;
            margin-bottom: 2.5rem;
        }

        .metric-card {
            background: var(--color-bg-light);
            border: 1px solid var(--color-border);
            border-radius: 8px;
            padding: 1.5rem 1rem;
        }

        .metric-title {
            font-size: 0.9rem;
            color: var(--color-text-muted);
            margin-bottom: 0.5rem;
            font-weight: 600;
        }

        .metric-value {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--color-primary);
            display: flex;
            align-items: baseline;
            justify-content: center;
            gap: 0.25rem;
        }

        .metric-unit {
            font-size: 0.85rem;
            font-weight: normal;
            color: var(--color-text-muted);
        }

        /* Progress Bar */
        .meter-container {
            margin-bottom: 2.5rem;
            text-align: right;
        }

        .meter-label {
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: var(--color-primary);
            display: flex;
            justify-content: space-between;
        }

        .meter {
            background: var(--color-border);
            border-radius: 999px;
            overflow: hidden;
            height: 12px;
            width: 100%;
        }

        .meter-fill {
            background: linear-gradient(90deg, var(--color-accent), var(--color-success));
            height: 100%;
            width: 0%; /* Starts at 0, JS animates it */
            transition: width 0.1s linear;
        }

        /* Start Button */
        .btn-start {
            background-color: var(--color-accent);
            color: #0F1419; /* Kept dark for visibility */
            padding: 1rem 2.5rem;
            border-radius: 999px;
            border: none;
            font-weight: 700;
            font-size: 1.1rem;
            cursor: pointer;
            transition: all 0.2s;
            box-shadow: 0 4px 12px rgba(0, 217, 255, 0.3);
            margin-bottom: 2rem;
        }

        .btn-start:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(0, 217, 255, 0.4);
        }

        .btn-start:disabled {
            background-color: var(--color-border);
            color: var(--color-text-muted);
            cursor: not-allowed;
            box-shadow: none;
        }

        .links a {
            color: var(--color-primary);
            text-decoration: none;
            font-weight: 600;
            font-size: 0.95rem;
            transition: color 0.2s;
        }

        .links a:hover {
            color: var(--color-accent);
        }
    </style>
</head>
<body>
    <div class="box">
        <h2>בדיקת מהירות אינטרנט</h2>
        <p class="subtitle">בדוק את ביצועי החיבור שלך לרשת הסיבים של Comunication_LTD</p>
        
        <div class="metrics">
            <div class="metric-card">
                <div class="metric-title">פינג (Ping)</div>
                <div class="metric-value" id="val-ping">-- <span class="metric-unit">ms</span></div>
            </div>
            <div class="metric-card">
                <div class="metric-title">הורדה (Download)</div>
                <div class="metric-value" id="val-down">-- <span class="metric-unit">Mbps</span></div>
            </div>
            <div class="metric-card">
                <div class="metric-title">העלאה (Upload)</div>
                <div class="metric-value" id="val-up">-- <span class="metric-unit">Mbps</span></div>
            </div>
        </div>

        <div class="meter-container">
            <div class="meter-label">
                <span id="meter-status">מוכן לבדיקה</span>
                <span id="meter-percent">0%</span>
            </div>
            <div class="meter">
                <div class="meter-fill" id="meter-bar"></div>
            </div>
        </div>

        <button class="btn-start" id="start-btn" onclick="startTest()">התחל בדיקה</button>
        
        <div class="links">
            <a asp-action="Index">חזור לדף הבית</a>
        </div>
    </div>

    <!-- JavaScript to simulate the Speed Test -->
    <script>
        function startTest() {
            const btn = document.getElementById('start-btn');
            const bar = document.getElementById('meter-bar');
            const status = document.getElementById('meter-status');
            const percent = document.getElementById('meter-percent');
            
            const pingVal = document.getElementById('val-ping');
            const downVal = document.getElementById('val-down');
            const upVal = document.getElementById('val-up');

            // Reset UI for new test
            btn.disabled = true;
            btn.innerText = 'בודק...';
            pingVal.innerHTML = '-- <span class="metric-unit">ms</span>';
            downVal.innerHTML = '-- <span class="metric-unit">Mbps</span>';
            upVal.innerHTML = '-- <span class="metric-unit">Mbps</span>';
            
            let progress = 0;
            status.innerText = 'מתחבר לשרת הקרוב...';

            const interval = setInterval(() => {
                progress += 1;
                bar.style.width = progress + '%';
                percent.innerText = progress + '%';

                // Simulate Ping Test at 15%
                if(progress === 15) {
                    pingVal.innerHTML = (Math.floor(Math.random() * 4) + 2) + ' <span class="metric-unit">ms</span>';
                    status.innerText = 'בודק מהירות הורדה...';
                }
                
                // Simulate Download Test at 50%
                if(progress === 50) {
                    downVal.innerHTML = (Math.floor(Math.random() * 150) + 800) + ' <span class="metric-unit">Mbps</span>';
                    status.innerText = 'בודק מהירות העלאה...';
                }
                
                // Simulate Upload Test at 85%
                if(progress === 85) {
                    upVal.innerHTML = (Math.floor(Math.random() * 20) + 90) + ' <span class="metric-unit">Mbps</span>';
                }

                // Finish Test at 100%
                if(progress >= 100) {
                    clearInterval(interval);
                    status.innerText = 'הבדיקה הושלמה בהצלחה';
                    btn.disabled = false;
                    btn.innerText = 'בדוק שוב';
                }
            }, 30); // Speed of the progress bar animation
        }
    </script>
</body>
</html>