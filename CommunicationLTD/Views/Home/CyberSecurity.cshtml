@{
    ViewData["Title"] = "אבטחת סייבר";
}

<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Comunication_LTD</title>
    <style>
        :root {
            --color-primary: #0F2847;
            --color-accent: #00D9FF;
            --color-text-dark: #0F1419;
            --color-text-muted: #6B7280;
            --color-bg-light: #F7F9FC;
            --color-border: #E5E7EB;
        }
        
        body { 
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; 
            background: var(--color-bg-light); 
            color: var(--color-text-dark); 
            margin: 0; 
            padding: 3rem 1.5rem; 
            line-height: 1.6;
        }
        
        .box { 
            background: white; 
            border-radius: 12px; 
            padding: 2.5rem; 
            max-width: 650px; 
            margin: auto; 
            box-shadow: 0 10px 30px rgba(15, 40, 71, 0.08); 
            border-top: 4px solid var(--color-accent);
        }
        
        h2 { 
            color: var(--color-primary); 
            margin-top: 0;
            margin-bottom: 1rem;
            font-size: 2rem;
        }
        
        p {
            color: var(--color-text-muted);
            margin-bottom: 2rem;
            font-size: 1.05rem;
        }
        
        .features-list {
            list-style: none;
            padding: 0;
            margin: 0 0 2.5rem 0;
        }
        
        .features-list li {
            padding: 1rem 0;
            border-bottom: 1px solid var(--color-border);
            display: flex;
            align-items: center;
            gap: 1rem;
            color: var(--color-text-dark);
            font-weight: 500;
        }
        
        .features-list li:last-child {
            border-bottom: none;
        }
        
        .features-list li::before {
            content: '✓';
            color: var(--color-accent);
            font-weight: bold;
            font-size: 1.2rem;
        }
        
        .btn-back { 
            display: inline-block;
            background-color: var(--color-primary); 
            color: #FFFFFF;
            padding: 0.875rem 1.5rem;
            border-radius: 6px;
            text-decoration: none; 
            font-weight: 600;
            transition: all 0.2s;
            text-align: center;
        }
        
        .btn-back:hover {
            background-color: #1A3A52;
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(15, 40, 71, 0.2);
        }
    </style>
</head>
<body>
    <div class="box">
        <h2>אבטחת סייבר מתקדמת</h2>
        <p>בחברת <strong>ComunicationLTD</strong>, הביטחון של המידע שלך הוא בראש סדר העדיפויות שלנו. רשת התקשורת שלנו מוגנת בסטנדרטים המחמירים ביותר כדי להבטיח שקט נפשי לכל לקוח.</p>
        
        <ul class="features-list">
            <li>הגנה אקטיבית מפני איומי סייבר ומתקפות רשת בזמן אמת</li>
            <li>הצפנת נתונים מתקדמת לשמירה על פרטיות המשתמשים</li>
            <li>מנגנוני אימות מאובטחים (HMAC + Salt) להגנה על חשבונות</li>
            <li>חומת אש (Firewall) ארגונית לסינון תעבורה זדונית</li>
        </ul>

        <a asp-action="Index" class="btn-back">חזור לדף הבית</a>
    </div>
</body>
</html>