@{
    ViewData["Title"] = "תשלום חשבון";
}

<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Comunication_LTD</title>
    <style>
        :root {
            --color-primary: #0F2847;
            --color-accent: #00D9FF;
            --color-success: #10B981;
            --color-text-dark: #0F1419;
            --color-text-muted: #6B7280;
            --color-bg-light: #F7F9FC;
            --color-border: #E5E7EB;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: var(--color-bg-light);
            color: var(--color-text-dark);
            margin: 0;
            padding: 3rem 1.5rem;
            line-height: 1.6;
        }

        .box {
            background: white;
            border-radius: 12px;
            padding: 2.5rem;
            max-width: 500px;
            margin: auto;
            box-shadow: 0 10px 30px rgba(15, 40, 71, 0.08);
            border-top: 4px solid var(--color-success);
        }

        h2 {
            color: var(--color-primary);
            margin-top: 0;
            margin-bottom: 0.5rem;
            font-size: 1.8rem;
            text-align: center;
        }

        p.subtitle {
            text-align: center;
            color: var(--color-text-muted);
            margin-bottom: 2rem;
            font-size: 0.95rem;
        }

        /* Invoice Summary */
        .invoice-summary {
            background: var(--color-bg-light);
            border: 1px solid var(--color-border);
            border-radius: 8px;
            padding: 1.5rem;
            margin-bottom: 2rem;
        }

        .invoice-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 0.5rem;
            color: var(--color-text-dark);
        }

        .invoice-row.total {
            margin-top: 1rem;
            padding-top: 1rem;
            border-top: 2px dashed var(--color-border);
            font-weight: 700;
            font-size: 1.2rem;
            color: var(--color-primary);
        }

        /* Form Inputs */
        .input-group {
            margin-bottom: 1.2rem;
            text-align: right;
        }

        .input-group label {
            display: block;
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: var(--color-primary);
        }

        .input-group input {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 1px solid var(--color-border);
            border-radius: 6px;
            font-family: inherit;
            font-size: 1rem;
            box-sizing: border-box;
            transition: border-color 0.2s;
        }

        .input-group input:focus {
            outline: none;
            border-color: var(--color-accent);
            box-shadow: 0 0 0 3px rgba(0, 217, 255, 0.1);
        }

        .row {
            display: flex;
            gap: 1rem;
        }

        .row .input-group {
            flex: 1;
        }

        /* Button */
        .btn-pay {
            width: 100%;
            background-color: var(--color-success);
            color: white;
            padding: 1rem;
            border: none;
            border-radius: 8px;
            font-weight: 700;
            font-size: 1.1rem;
            cursor: pointer;
            transition: all 0.2s;
            margin-top: 1rem;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
        }

        .btn-pay:hover:not(:disabled) {
            transform: translateY(-2px);
            background-color: #0ea5e9; /* Switch to a bright blue on hover just for flair */
        }

        .btn-pay:disabled {
            background-color: var(--color-text-muted);
            cursor: not-allowed;
            box-shadow: none;
        }

        .links {
            text-align: center;
            margin-top: 1.5rem;
        }

        .links a {
            color: var(--color-primary);
            text-decoration: none;
            font-weight: 600;
            font-size: 0.95rem;
            transition: color 0.2s;
        }

        .links a:hover {
            color: var(--color-accent);
        }

        #success-message {
            display: none;
            text-align: center;
            color: var(--color-success);
            font-weight: 700;
            font-size: 1.2rem;
            margin-top: 1.5rem;
        }
    </style>
</head>
<body>
    <div class="box">
        <h2>תשלום חשבון מאובטח</h2>
        <p class="subtitle">תשלום עבור שירותי אינטרנט - חודש אוגוסט</p>

        <div class="invoice-summary">
            <div class="invoice-row">
                <span>חבילת סיבים 1000Mbps</span>
                <span>₪120.00</span>
            </div>
            <div class="invoice-row">
                <span>השכרת נתב חכם</span>
                <span>₪19.90</span>
            </div>
            <div class="invoice-row total">
                <span>סה"כ לתשלום</span>
                <span>₪139.90</span>
            </div>
        </div>

        <form id="payment-form" onsubmit="processPayment(event)">
            <div class="input-group">
                <label>שם בעל הכרטיס</label>
                <input type="text" placeholder="ישראל ישראלי" required />
            </div>
            <div class="input-group">
                <label>מספר כרטיס אשראי</label>
                <input type="text" placeholder="0000 0000 0000 0000" dir="ltr" required />
            </div>
            <div class="row">
                <div class="input-group">
                    <label>תוקף (MM/YY)</label>
                    <input type="text" placeholder="12/25" dir="ltr" required />
                </div>
                <div class="input-group">
                    <label>CVV</label>
                    <input type="text" placeholder="123" dir="ltr" required />
                </div>
            </div>

            <button type="submit" class="btn-pay" id="pay-btn">שלם עכשיו ₪139.90</button>
        </form>

        <div id="success-message">
            ✅ התשלום התקבל בהצלחה! קבלה נשלחה למייל.
        </div>

        <div class="links">
            <a asp-action="Index">חזור לדף הבית</a>
        </div>
    </div>

    <script>
        function processPayment(e) {
            e.preventDefault(); // Prevents page reload
            
            const btn = document.getElementById('pay-btn');
            const successMsg = document.getElementById('success-message');
            const formInputs = document.querySelectorAll('input');

            // Disable button and show loading text
            btn.disabled = true;
            btn.innerText = 'מעבד תשלום...';

            // Simulate server request time (2 seconds)
            setTimeout(() => {
                btn.style.display = 'none'; // Hide button
                successMsg.style.display = 'block'; // Show success message
                
                // Disable inputs
                formInputs.forEach(input => input.disabled = true);
            }, 2000);
        }
    </script>
</body>
</html>